{
    "name": "lensmedia/symfony-my-parcel",
    "description": "Symfony bundle to summarize Myparcel features",
    "type": "symfony-bundle",
    "require": {
        "symfony/framework-bundle": "^7.0 || ^8.0",
        "myparcelnl/sdk": "^10.7",
        "symfony/translation": "^7.0 || ^8.0",
        "symfony/dependency-injection": "^7.0 || ^8.0"
    },
    "require-dev": {
        "symfony/twig-bundle": "^7.0 || ^8.0",
        "symfony/ux-twig-component": "^2.0 || ^3.0"
    },
    "suggest": {
        "symfony/ux-twig-component": "To use the MyParcel twig components"
    },
    "autoload": {
        "psr-4": {
            "Lens\\Bundle\\MyParcelBundle\\": "src/"
        }
    }
}
